{
  "name": "matvision-studio",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:native": "wdio run wdio.conf.ts",
    "test:fixtures": "node tests/fixtures/generate.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "10.0.10",
    "@types/node": "26.5.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.4.0",
    "@wdio/types": "9.31.2",
    "eslint": "10.10.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
